{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "@/*": [
        "./app/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@engine/*": [
        "./engine/*"
      ],
      "@arcon/*": [
        "./app/arcon/*"
      ],
      "next/link": [
        "./app/arcon/shims/link.tsx"
      ],
      "next/navigation": [
        "./app/arcon/shims/navigation.ts"
      ]
    },
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*",
    "engine/**/*.ts"
  ],
  "exclude": [
    "engine/**/*.test.ts"
  ]
}
